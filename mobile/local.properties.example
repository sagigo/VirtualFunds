# Copy this file to local.properties and fill in your values.
# local.properties is gitignored and must never be committed.

# Android SDK location (Android Studio sets this automatically)
sdk.dir=C\:\\Users\\<your_username>\\AppData\\Local\\Android\\Sdk

# Supabase credentials (get these from your Supabase project settings)
SUPABASE_URL=https\://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
